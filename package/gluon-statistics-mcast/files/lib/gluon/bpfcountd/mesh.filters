IP6:SSDP;${IP6} && ${%SSDP}
IP6:LLMNR;${IP6} && ${%LLMNR}
IP6:MDNS;${IP6} && ${%MDNS}
IP6:NB-NS;${IP6} && ${%NB-NS}
IP6:NB-DGM;${IP6} && ${%NB-DGM}
