%MC;(ip multicast or ip6 multicast)

%SSDP;${%MC} && udp dst port 1900
%LLMNR;${%MC} && udp dst port 5355
%MDNS;${%MC} && udp dst port 5353
%NB-NS;${%MC} && udp dst port 137
%NB-DGM;${%MC} && udp dst port 138
%DP-LSP;${%MC} && udp dst port 17500
%TRAP-DAEMON;${%MC} && udp dst port 3600
%DHCP4;${%MC} && udp port (67 || 68)
%DHCP6;${%MC} && udp port (546 || 547)
%WS-DISC;${%MC} && udp port 3702
%WSP;${%MC} && udp dst port 9200
%TEREDO;${%MC} && udp dst port 3544
%SPOTIFY;${%MC} && udp dst port 57621
%SIP;${%MC} && udp dst port 5060
%BT-LPD;${%MC} && udp dst port 6771
%NVBM;${%MC} && udp dst port 8225
%SVRLOC;${%MC} && udp dst port 427
%ENPC;${%MC} && udp dst port 3289
%QTSTREAM;${%MC} && udp dst port 7555
%HDHOMERUN;${%MC} && udp dst port 65001
%PLEX-DISC0;${%MC} && udp dst port 32410
%PLEX-DISC2;${%MC} && udp dst port 32412
%PLEX-DISC3;${%MC} && udp dst port 32413
%PLEX-DISC4;${%MC} && udp dst port 32414
%BT-UTP;${%MC} && udp dst port 16680
%WF-BSSERV;${%MC} && udp dst port 61117
%FAXIMUM;${%MC} && udp dst port 7437
%TOMCAT;${%MC} && udp dst port 9006
%DISTINCT;${%MC} && udp dst port 9999
%UDP-25412;${%MC} && udp dst port 25412
%UDP-10203;${%MC} && udp dst port 10203
%UDP-60128;${%MC} && udp dst port 60128
%COREL-VNC;${%MC} && udp dst port 2654
%HPVMMCTRL;${%MC} && udp dst port 1124
%CBT;${%MC} && udp dst port 7777
%MCAFEE;${%MC} && udp dst port 6646
%UDP-39455;${%MC} && udp dst port 39455
%UDP-889;${%MC} && udp dst port 889
%UDP-16962;${%MC} && udp dst port 16962
%TSEQ;${%MC} && udp dst port 0
%CANON-BJNP;${%MC} && udp dst port 8612
%RIP;${%MC} && udp dst port 520
%RIPNG;${%MC} && udp dst port 521
%OSPF;${%MC} && ip proto 0x59
%PIM;${%MC} && ((ip proto 103) or ((ip proto 2) and (ip[20] == 0x14)))
%BABEL;${%MC} && udp dst port 6696
%RESPONDD-QRY;${%MC} && udp dst port 1001

%HBH6;${%MC} && ip6 proto 0
%ICMP6;${%MC} && ip6 proto 58
%ICMP6:ECHOREQ;${%ICMP6} && icmp6[icmp6type] = icmp6-echo
%ICMP6:ECHOREP;${%ICMP6} && icmp6[icmp6type] = icmp6-echoreply
%ICMP6:NDSOL;${%ICMP6} && icmp6[icmp6type] = icmp6-neighborsolicit
%ICMP6:NDADV;${%ICMP6} && icmp6[icmp6type] = icmp6-neighboradvert
%ICMP6:NDADV:UNSOL;${%ICMP6:NDADV} and ip6 host ff02::1
%ICMP6:NDADV:OTHER;${%ICMP6:NDADV} and not (ip6 host ff02::1)
%ICMP6:RTRSOL;${%ICMP6} && icmp6[icmp6type] = icmp6-routersolicit
%ICMP6:RTRADV;${%ICMP6} && icmp6[icmp6type] = icmp6-routeradvert

IP4;ip
IP6;ip6
BLA;arp and arp[0:2] = 0x0001 and arp[2:2] = 0x0800 and arp[6:2] = 0x0002 and arp[14:4] = 0x00000000 and arp[18:2] = 0xff43 and arp[20:1] = 0x05 and arp[24:4] = 0x00000000
ARP;arp and not ${BLA}
IPX;ipx
NETBEUI;netbeui

IP4:IGMP;${IP4} && igmp
IP4:IGMP:QUERY-V1;${IP4:IGMP} and igmp[0] = 0x11 and ip[2:2] = 0x0020 and igmp[1] = 0x00
IP4:IGMP:QUERY-V2;${IP4:IGMP} and igmp[0] = 0x11 and ip[2:2] = 0x0020 and not (igmp[1] = 0x00)
IP4:IGMP:QUERY-V3;${IP4:IGMP} and igmp[0] = 0x11 and ip[2:2] >= 0x0024
IP4:IGMP:QUERY-UNKNOWN;${IP4:IGMP} and igmp[0] = 0x11 and not ((ip[2:2] = 0x0020 and igmp[1] = 0x00) or (ip[2:2] = 0x0020 and not (igmp[1] = 0x00)) or ip[2:2] >= 0x0024)
IP4:IGMP:REPORT-V1;${IP4:IGMP} and igmp[0] = 0x12
IP4:IGMP:REPORT-V2;${IP4:IGMP} and igmp[0] = 0x16
IP4:IGMP:LEAVE-V2;${IP4:IGMP} and igmp[0] = 0x17
IP4:IGMP:REPORT-V3;${IP4:IGMP} and igmp[0] = 0x22
IP4:IGMP:MRD-ADV;${IP4:IGMP} and igmp[0] = 0x30
IP4:IGMP:MRD-SOL;${IP4:IGMP} and igmp[0] = 0x31
IP4:IGMP:MRD-TERM;${IP4:IGMP} and igmp[0] = 0x32

IP4:SSDP;${IP4} && ${%SSDP}
IP4:LLMNR;${IP4} && ${%LLMNR}
IP4:MDNS;${IP4} && ${%MDNS}
IP4:NB-NS;${IP4} && ${%NB-NS}
