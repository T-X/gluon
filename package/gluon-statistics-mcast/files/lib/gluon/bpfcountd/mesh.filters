BAT-BCAST:IPX;${BAT-BCAST} && ${IPX}
BAT-BCAST:NETBEUI;${BAT-BCAST} && ${NETBEUI}
BAT-BCAST:OTHER;${BAT-BCAST} && not (${BAT-BCAST:IP4} || ${BAT-BCAST:IP6} || ${BAT-BCAST:BLA} || ${BAT-BCAST:ARP} || ${BAT-BCAST:IPX} || ${BAT-BCAST:NETBEUI})

BAT-UCAST:IP4;${BAT-UCAST} && ${IP4}
