IP6:CBT;${IP6} && ${%CBT}
IP6:MCAFEE;${IP6} && ${%MCAFEE}
IP6:UDP-39455;${IP6} && ${%UDP-39455}
IP6:UDP-889;${IP6} && ${%UDP-889}
IP6:UDP-16962;${IP6} && ${%UDP-16962}
IP6:TSEQ;${IP6} && ${%TSEQ}
IP6:CANON-BJNP;${IP6} && ${%CANON-BJNP}
IP6:RIP;${IP6} && ${%RIP}
IP6:RIPNG;${IP6} && ${%RIPNG}
IP6:OSPF;${IP6} && ${%OSPF}
IP6:PIM;${IP6} && ${%PIM}
IP6:BABEL;${IP6} && ${%BABEL}
IP6:RESPONDD-QRY;${IP6} && ${%RESPONDD-QRY}
IP6:MC-ALL;${IP6} && ${%MC}

IP6:HBH6;ip6 && ${%HBH6}
IP6:ICMP6;ip6 && ${%ICMP6}

IP6:HBH6:MLD;${IP6:HBH6} and ip6[40] = 58 and ip6[41] = 0x00 and ip6[42:4] = 0x05020000 and (ip6[46:2] = 0x0000 or ip6[46:2] = 0x0100)
IP6:HBH6:MLD:QUERY-V1;${IP6:HBH6:MLD} and ip6[48] = 130 and ip6[4:2] = 0x0020
IP6:HBH6:MLD:QUERY-V1:GENERAL;${IP6:HBH6:MLD:QUERY-V1} and ip6[56:4] = 0x00000000 and ip6[60:4] = 0x00000000 and ip6[64:4] = 0x00000000 and ip6[68:4] = 0x00000000
IP6:HBH6:MLD:QUERY-V1:ADDRSPEC;${IP6:HBH6:MLD:QUERY-V1} and not (ip6[56:4] = 0x00000000 and ip6[60:4] = 0x00000000 and ip6[64:4] = 0x00000000 and ip6[68:4] = 0x00000000)
IP6:HBH6:MLD:QUERY-V2;${IP6:HBH6:MLD} and ip6[48] = 130 and ip6[4:2] >= 0x0024
IP6:HBH6:MLD:QUERY-V2:GENERAL;${IP6:HBH6:MLD:QUERY-V2} and ip6[56:4] = 0x00000000 and ip6[60:4] = 0x00000000 and ip6[64:4] = 0x00000000 and ip6[68:4] = 0x00000000
IP6:HBH6:MLD:QUERY-V2:ADDRSPEC;${IP6:HBH6:MLD:QUERY-V2} and not (ip6[56:4] = 0x00000000 and ip6[60:4] = 0x00000000 and ip6[64:4] = 0x00000000 and ip6[68:4] = 0x00000000)
IP6:HBH6:MLD:QUERY-UNKNOWN;${IP6:HBH6:MLD} and ip6[48] = 130 and not (ip6[4:2] = 0x0020 or ip6[4:2] >= 0x0024)
IP6:HBH6:MLD:REPORT-V1;${IP6:HBH6:MLD} and ip6[48] = 131
IP6:HBH6:MLD:DONE-V1;${IP6:HBH6:MLD} and ip6[48] = 132
IP6:HBH6:MLD:REPORT-V2;${IP6:HBH6:MLD} and ip6[48] = 143
IP6:HBH6:MLD:MRD-ADV;${IP6:HBH6:MLD} and ip6[48] = 151
IP6:HBH6:MLD:MRD-SOL;${IP6:HBH6:MLD} and ip6[48] = 152
IP6:HBH6:MLD:MRD-TERM;${IP6:HBH6:MLD} and ip6[48] = 153
IP6:HBH6:OTHER;${IP6:HBH6} and not ${IP6:HBH6:MLD}

IP6:ICMP6:ECHOREQ;${IP6} && ${%ICMP6:ECHOREQ}
IP6:ICMP6:ECHOREP;${IP6} && ${%ICMP6:ECHOREP}
IP6:ICMP6:NDSOL;${IP6} && ${%ICMP6:NDSOL}
IP6:ICMP6:NDADV;${IP6} && ${%ICMP6:NDADV}
IP6:ICMP6:NDADV:UNSOL;${IP6} and ${%ICMP6:NDADV:UNSOL}
IP6:ICMP6:NDADV:OTHER;${IP6} and ${%ICMP6:NDADV:OTHER}
IP6:ICMP6:RTRSOL;${IP6} && ${%ICMP6:RTRSOL}
IP6:ICMP6:RTRADV;${IP6} && ${%ICMP6:RTRADV}
IP6:ICMP6:OTHER;${IP6:ICMP6} && not (${%ICMP6:ECHOREQ} || ${%ICMP6:ECHOREP} || ${%ICMP6:NDSOL} || ${%ICMP6:NDADV} || ${%ICMP6:RTRSOL} || ${%ICMP6:RTRADV})

BLA-CLAIM;${BLA} and arp[21:1] = 0x00
BLA-UNCLAIM;${BLA} and arp[21:1] = 0x01
BLA-ANNOUNCE;${BLA} and arp[21:1] = 0x02
BLA-REQUEST;${BLA} and arp[21:1] = 0x03
BLA-LOOPDETECT;${BLA} and arp[21:1] = 0x04

ARP:REQ;${ARP} and arp[6:2] = 0x0001
ARP:REQ:UNSOL;${ARP:REQ} and arp[18:4] = 0xffffffff and arp[22:2] = 0xffff
ARP:REQ:OTHER;${ARP:REQ} and not (arp[18:4] = 0xffffffff and arp[22:2] = 0xffff)
ARP:REP;${ARP} and arp[6:2] = 0x0002
ARP:REP:UNSOL;${ARP:REP} and arp[18:4] = 0xffffffff and arp[22:2] = 0xffff
ARP:REP:OTHER;${ARP:REP} and not (arp[18:4] = 0xffffffff and arp[22:2] = 0xffff)


BAT-OGM_IV;batadv 15 iv_ogm
BAT-OGM_V;batadv 15 ogm2
BAT-ELP;batadv 15 elp
BAT-UCAST;batadv 15 unicast
BAT-UCAST4;batadv 15 unicast_4addr
BAT-UCAST_FRAG;batadv 15 unicast_frag
BAT-UCAST_TVLV;batadv 15 unicast_tvlv
BAT-BCAST;batadv 15 bcast
BAT-ICMP;batadv 15 \icmp
BAT-CODED;batadv 15 coded
BAT-ALL;batadv
BAT-OTHER;batadv and not (${BAT-OGM_IV} || ${BAT-OGM_V} || ${BAT-ELP} || ${BAT-UCAST} || ${BAT-UCAST4} || ${BAT-UCAST_FRAG} || ${BAT-UCAST_TVLV} || ${BAT-BCAST} || ${BAT-ICMP} || ${BAT-CODED})


BAT-BCAST:IP4;${BAT-BCAST} && ${IP4}
BAT-BCAST:IP6;${BAT-BCAST} && ${IP6}
BAT-BCAST:BLA;${BAT-BCAST} && ${BLA}
