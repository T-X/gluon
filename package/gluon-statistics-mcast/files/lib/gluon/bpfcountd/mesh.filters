IP6:WS-DISC;${IP6} && ${%WS-DISC}
IP6:WSP;${IP6} && ${%WSP}
IP6:TEREDO;${IP6} && ${%TEREDO}
IP6:SPOTIFY;${IP6} && ${%SPOTIFY}
IP6:SIP;${IP6} && ${%SIP}
IP6:BT-LPD;${IP6} && ${%BT-LPD}
IP6:NVBM;${IP6} && ${%NVBM}
IP6:SVRLOC;${IP6} && ${%SVRLOC}
IP6:ENPC;${IP6} && ${%ENPC}
IP6:QTSTREAM;${IP6} && ${%QTSTREAM}
IP6:HDHOMERUN;${IP6} && ${%HDHOMERUN}
IP6:PLEX-DISC0;${IP6} && ${%PLEX-DISC0}
IP6:PLEX-DISC2;${IP6} && ${%PLEX-DISC2}
IP6:PLEX-DISC3;${IP6} && ${%PLEX-DISC3}
