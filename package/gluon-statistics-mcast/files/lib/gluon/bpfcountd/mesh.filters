BAT-UCAST:IP6:ICMP6:ECHOREQ;${BAT-UCAST:IP6} && ${%ICMP6:ECHOREQ}
BAT-UCAST:IP6:ICMP6:ECHOREP;${BAT-UCAST:IP6} && ${%ICMP6:ECHOREP}
BAT-UCAST:IP6:ICMP6:NDSOL;${BAT-UCAST:IP6} && ${%ICMP6:NDSOL}
BAT-UCAST:IP6:ICMP6:NDADV;${BAT-UCAST:IP6} && ${%ICMP6:NDADV}
BAT-UCAST:IP6:ICMP6:NDADV:UNSOL;${BAT-UCAST:IP6} and ${%ICMP6:NDADV:UNSOL}
BAT-UCAST:IP6:ICMP6:NDADV:OTHER;${BAT-UCAST:IP6} and ${%ICMP6:NDADV:OTHER}
BAT-UCAST:IP6:ICMP6:RTRSOL;${BAT-UCAST:IP6} && ${%ICMP6:RTRSOL}
BAT-UCAST:IP6:ICMP6:RTRADV;${BAT-UCAST:IP6} && ${%ICMP6:RTRADV}
BAT-UCAST:IP6:HBH6:MLD:MRD-ADV;${BAT-UCAST} && ${IP6:HBH6:MLD:MRD-ADV}
BAT-UCAST:IP6:HBH6:MLD:MRD-SOL;${BAT-UCAST} && ${IP6:HBH6:MLD:MRD-SOL}
BAT-UCAST:IP6:HBH6:MLD:MRD-TERM;${BAT-UCAST} && ${IP6:HBH6:MLD:MRD-TERM}
BAT-UCAST:IP6:ICMP6:OTHER;${BAT-UCAST:IP6:ICMP6} && not (${%ICMP6:ECHOREQ} || ${%ICMP6:ECHOREP} || ${%ICMP6:NDSOL} || ${%ICMP6:NDADV} || ${%ICMP6:RTRSOL} || ${%ICMP6:RTRADV})

BAT-UCAST:BLA:CLAIM;${BAT-UCAST} and ${BLA-CLAIM}
BAT-UCAST:BLA:UNCLAIM;${BAT-UCAST} and ${BLA-UNCLAIM}
BAT-UCAST:BLA:ANNOUNCE;${BAT-UCAST} and ${BLA-ANNOUNCE}
BAT-UCAST:BLA:REQUEST;${BAT-UCAST} and ${BLA-REQUEST}
BAT-UCAST:BLA:LOOPDETECT;${BAT-UCAST} and ${BLA-LOOPDETECT}

BAT-UCAST:ARP:REQ;${BAT-UCAST} and ${ARP:REQ}
BAT-UCAST:ARP:REQ:UNSOL;${BAT-UCAST} and ${ARP:REQ:UNSOL}
BAT-UCAST:ARP:REQ:OTHER;${BAT-UCAST} and ${ARP:REQ:OTHER}
BAT-UCAST:ARP:REP;${BAT-UCAST} and ${ARP:REP}
BAT-UCAST:ARP:REP:UNSOL;${BAT-UCAST} and ${ARP:REP:UNSOL}
BAT-UCAST:ARP:REP:OTHER;${BAT-UCAST} and ${ARP:REP:OTHER}
